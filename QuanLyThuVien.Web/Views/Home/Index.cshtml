@* /home/index *@

@model QuanLyThuVien.Web.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Tìm kiếm sách";
    bool isSortByTitle = Model.SortBy == "title_asc" || Model.SortBy == "title_desc";
    bool isSortByYear = Model.SortBy == "year_asc" || Model.SortBy == "year_desc";
}

<div class="container-fluid mt-3 px-4">

    <!--form tìm kiếm home/index -->
    <form asp-controller="Home" asp-action="Index" method="get" id="searchForm" class="mb-4 bg-white p-3 border-bottom shadow-sm">
        <input type="hidden" name="sortBy" value="@Model.SortBy" />

        <div class="row g-3">
            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Tên tác giả :</label>
                <input type="text" name="searchAuthor" value="@Model.SearchAuthor" class="form-control rounded-0 bg-light border-0" />
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Mã sách :</label>
                <input type="text" name="searchISBN" value="@Model.SearchISBN" class="form-control rounded-0 bg-light border-0" />
            </div>

            <div class="w-100 d-none d-md-block m-0"></div> <!-- Xuống dòng -->

            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Tên sách :</label>
                <input type="text" name="searchTitle" value="@Model.SearchTitle" class="form-control rounded-0 bg-light border-0" />
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Năm xuất bản :</label>
                <input type="number" name="publishYear" value="@Model.PublishYear" class="form-control rounded-0 bg-light border-0" />
            </div>

            <div class="w-100 d-none d-md-block m-0"></div> <!-- Xuống dòng -->

            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Thể loại :</label>
                <select name="categoryId" asp-items="@Model.Categories" class="form-select rounded-0 bg-light border-0">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <div class="col-md-5 d-flex align-items-center justify-content-end gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4 rounded-0 border-0 text-dark">Tìm kiếm</button>

                <!-- button thêm sách nếu là role admin -->
                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="btn btn-success fw-bold px-4 rounded-0 border-0" data-bs-toggle="modal" data-bs-target="#addBookModal">
                        Thêm sách
                    </button>
                }
            </div>
        </div>
    </form>

    <!-- button sắp xếp -->
    <div class="d-flex align-items-center mb-4">
        <span class="fw-bold me-3">Sắp xếp :</span>
        <a href="@Url.Action("Index", new { sortBy = Model.SortBy == "title_asc" ? "title_desc" : "title_asc", searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })"
           class="badge text-white text-decoration-none p-2 me-2 fs-6 rounded-0 @(isSortByTitle ? "bg-info" : "bg-secondary")">
            Tên sách @(Model.SortBy == "title_asc" ? "↓" : Model.SortBy == "title_desc" ? "↑" : "")
        </a>
        <a href="@Url.Action("Index", new { sortBy = Model.SortBy == "year_asc" ? "year_desc" : "year_asc", searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })"
           class="badge text-white text-decoration-none p-2 fs-6 rounded-0 @(isSortByYear ? "bg-info" : "bg-secondary")">
            Năm sản xuất @(Model.SortBy == "year_asc" ? "↓" : Model.SortBy == "year_desc" ? "↑" : "")
        </a>
    </div>

    <!-- hiển thị sách -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @if (Model.Books != null && Model.Books.Items.Any())
        {
            @foreach (var book in Model.Books.Items)
            {
                <div class="col">
                    <div class="card h-100 border rounded-0 shadow-sm book-item" data-id="@book.Id" style="cursor: pointer; background-color: #f9f9f9;overflow: hidden;">

                        <!-- ảnh bìa sách -->
                        <div class="text-center pt-3" style="background: #eee9e9; background-size: cover;">
                            <img src="@(string.IsNullOrEmpty(book.CoverImage) ? "/images/no-cover.png" : book.CoverImage)"
                                 alt="@book.Title" style="height: 220px; object-fit: fill;" 
                                 class="w-100"/>
                        </div>

                        <div class="card-body bg-white border-top position-relative px-3 py-3">
                            <h5 class="card-title fw-bold text-center mb-3 text-truncate" title="@book.Title">@book.Title</h5>

                            <p class="card-text mb-1" style="font-size: 0.9rem;">Tên tác giả : @book.Author</p>
                            <p class="card-text mb-1" style="font-size: 0.9rem;">Năm xuất bản : @book.PublishYear</p>
                            <p class="card-text mb-0" style="font-size: 0.9rem;">Thể loại : @(book.Category?.Name ?? "")</p>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-muted">Không tìm thấy cuốn sách nào phù hợp.</h5>
            </div>
        }
    </div>

    <!-- phân trang -->
    @if (Model.Books != null && Model.Books.TotalPages > 1)
    {
        <nav class="mt-5 mb-3 d-flex justify-content-center">
            <ul class="pagination pagination-sm border-0">
                <li class="page-item @(Model.Books.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link text-dark border-0 fs-5" href="@Url.Action("Index", new { pageNumber = Model.Books.PageNumber - 1, sortBy = Model.SortBy, searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })">&lt;&lt;</a>
                </li>
                @for (int i = 1; i <= Model.Books.TotalPages; i++)
                {
                    <li class="page-item">
                        <a class="page-link border-0 fs-5 @(i == Model.Books.PageNumber ? "fw-bold bg-transparent text-dark" : "text-dark")"
                           href="@Url.Action("Index", new { pageNumber = i, sortBy = Model.SortBy, searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Books.HasNextPage ? "" : "disabled")">
                    <a class="page-link text-dark border-0 fs-5" href="@Url.Action("Index", new { pageNumber = Model.Books.PageNumber + 1, sortBy = Model.SortBy, searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })">&gt;&gt;</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- gọi modal -->
<partial name="_InfoBookModalPartial" /> <!-- modal thông tin sách -->
@if (User.IsInRole("Admin"))
{
    <partial name="_AddBookModalPartial" /><!-- modal thêm sách -->
    <partial name="_EditBookModalPartial" /><!-- modal sửa sách-->
}



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // chỉnh sửa ảnh
            const imagePreviewContainer = document.getElementById('imagePreviewContainer');
            const imageInput = document.getElementById('imageInput');

            if (imagePreviewContainer && imageInput) {
                imagePreviewContainer.addEventListener('click', function() {
                    imageInput.click();
                });

                imageInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const imagePreview = document.getElementById('imagePreview');
                            imagePreview.src = e.target.result;
                            imagePreview.style.display = 'block'; // Tương đương .show()
                            imagePreviewContainer.style.background = 'none';
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }

            const editImagePreviewContainer = document.getElementById('editImagePreviewContainer');
            const editImageInput = document.getElementById('editImageInput');

            if (editImagePreviewContainer && editImageInput) {
                editImagePreviewContainer.addEventListener('click', function() {
                    editImageInput.click();
                });

                editImageInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            document.getElementById('editImagePreview').src = e.target.result;
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }

            // thêm sách
            const addBookForm = document.getElementById('addBookForm');
            if (addBookForm) {
                addBookForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);

                    const btnSaveBook = document.getElementById('btnSaveBook');
                    btnSaveBook.disabled = true;
                    btnSaveBook.textContent = 'Đang lưu...';

                    fetch('/Home/AddBook', {
                        method: 'POST',
                        body: formData // fetch với FormData tự động set content-type là multipart/form-data
                    })
                        .then(res => res.json())
                        .then(res => {
                            if (res.success) {
                                alert("Lưu thành công!");
                                location.reload();
                            } else {
                                alert("Lỗi: " + res.message);
                                btnSaveBook.disabled = false;
                                btnSaveBook.textContent = 'Lưu';
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            btnSaveBook.disabled = false;
                            btnSaveBook.textContent = 'Lưu';
                        });
                });
            }

            // sửa sách
            const editBookForm = document.getElementById('editBookForm');
            if (editBookForm) {
                editBookForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);

                    const btnSaveEditBook = document.getElementById('btnSaveEditBook');
                    btnSaveEditBook.disabled = true;
                    btnSaveEditBook.textContent = 'Đang lưu...';

                    fetch('/Home/EditBook', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => res.json())
                        .then(res => {
                            if (res.success) {
                                alert("Cập nhật sách thành công!");
                                location.reload();
                            } else {
                                alert("Lỗi: " + res.message);
                                btnSaveEditBook.disabled = false;
                                btnSaveEditBook.textContent = 'Lưu';
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            btnSaveEditBook.disabled = false;
                            btnSaveEditBook.textContent = 'Lưu';
                        });
                });
            }

            // click vào card mở modal thông tin sách
            const bookItems = document.querySelectorAll('.book-item');
            bookItems.forEach(item => {
                item.addEventListener('click', function() {
                    const bookId = this.getAttribute('data-id');

                    fetch('/Home/GetBookDetails?id=' + encodeURIComponent(bookId))
                        .then(response => {
                            if (!response.ok) throw new Error('Network response was not ok');
                            return response.json();
                        })
                        .then(data => {
                            // 1. Gán thông tin cơ bản
                            document.getElementById('infoBookId').value = data.id;
                            document.getElementById('infoCategory').textContent = data.categoryName || 'Chưa phân loại';
                            document.getElementById('infoISBN').textContent = data.isbn;
                            document.getElementById('infoTitle').textContent = data.title;
                            document.getElementById('infoAuthor').textContent = data.author;
                            document.getElementById('infoYear').textContent = data.publishYear;
                            document.getElementById('infoPublisher').textContent = data.publisher;
                            document.getElementById('infoLocation').textContent = data.suggestedLocation;

                            // 2. GÁN THÔNG TIN ERD MỚI (TỔNG SỐ VÀ KHẢ DỤNG)
                            document.getElementById('infoTotalCopies').textContent = data.totalCopies + ' cuốn';
                            document.getElementById('infoAvailableCopies').textContent = data.availableCount + ' cuốn';

                            // Khống chế ô chọn số lượng (Quantity)
                            const qtyInput = document.getElementById('infoQuantity');
                            if (qtyInput) {
                                qtyInput.setAttribute('max', data.availableCount); // Giới hạn tối đa
                                if (data.availableCount === 0) {
                                    qtyInput.value = 0;
                                    qtyInput.disabled = true; // Hết sách thì khóa ô nhập
                                } else {
                                    qtyInput.value = 1;
                                    qtyInput.disabled = false; // Còn sách thì cho nhập
                                }
                            }

                            // 3. Gán ảnh
                            const finalImg = data.coverImage ? data.coverImage : '/images/no-cover.png';
                            document.getElementById('infoImage').src = finalImg;

                            // 4. Các nút thao tác của Admin / Thủ thư
                            const btnOpenEdit = document.getElementById('btnOpenEdit');
                            if (btnOpenEdit) btnOpenEdit.setAttribute('data-id', data.id);

                            const btnManageCopies = document.getElementById('btnManageCopies');
                            if (btnManageCopies) btnManageCopies.href = '/BookCopies/Index?bookId=' + data.id;

                            const btnUpdateCopiesStatus = document.getElementById('btnUpdateCopiesStatus');
                            if (btnUpdateCopiesStatus) btnUpdateCopiesStatus.href = '/BookCopies/Index?bookId=' + data.id;

                            // Nút ẩn hiện
                            const btnToggle = document.getElementById('btnToggleVisibility');
                            if (btnToggle) {
                                btnToggle.setAttribute('data-id', data.id);
                                if (data.isActive) {
                                    btnToggle.classList.remove('btn-secondary');
                                    btnToggle.classList.add('btn-danger');
                                    btnToggle.textContent = 'Ẩn sách';
                                    btnToggle.setAttribute('data-action', 'hide');
                                } else {
                                    btnToggle.classList.remove('btn-danger');
                                    btnToggle.classList.add('btn-secondary');
                                    btnToggle.textContent = 'Hiện sách';
                                    btnToggle.setAttribute('data-action', 'show');
                                }
                            }

                            // Hiện modal (sử dụng Bootstrap 5 API)
                            const infoBookModal = new bootstrap.Modal(document.getElementById('infoBookModal'));
                            infoBookModal.show();
                        })
                        .catch(error => {
                            alert("Lỗi: Không thể lấy dữ liệu từ máy chủ.");
                        });
                });
            });

            //button ẩn hiện sách trong modal thông tin sách
            const btnToggleVisibility = document.getElementById('btnToggleVisibility');
            if (btnToggleVisibility) {
                // Đảm bảo không bind nhiều lần vì đã nằm trong DOMContentLoaded
                btnToggleVisibility.addEventListener('click', function() {
                    const bookId = this.getAttribute('data-id');
                    const action = this.getAttribute('data-action');
                    const url = action === 'hide' ? '/Home/HideBook' : '/Home/RestoreBook';
                    const confirmMsg = action === 'hide' ? "Bạn có chắc chắn muốn ẨN cuốn sách này?" : "Bạn có chắc chắn muốn HIỆN lại cuốn sách này?";

                    if (confirm(confirmMsg)) {
                        fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: new URLSearchParams({ id: bookId }).toString()
                        })
                            .then(res => res.json())
                            .then(res => {
                                if (res.success) {
                                    alert("Cập nhật trạng thái sách thành công!");
                                    location.reload();
                                } else {
                                    alert("Lỗi: " + res.message);
                                }
                            })
                            .catch(error => console.error('Error:', error));
                    }
                });
            }

            //button mở modal chỉnh sửa sách
            const btnOpenEdit = document.getElementById('btnOpenEdit');
            if (btnOpenEdit) {
                btnOpenEdit.addEventListener('click', function() {
                    const bookId = this.getAttribute('data-id');

                    // Ẩn modal info
                    const infoBookModalEl = document.getElementById('infoBookModal');
                    const infoModalInstance = bootstrap.Modal.getInstance(infoBookModalEl);
                    if (infoModalInstance) infoModalInstance.hide();

                    fetch('/Home/GetBookDetails?id=' + encodeURIComponent(bookId))
                        .then(response => response.json())
                        .then(data => {
                            document.getElementById('editId').value = data.id;
                            document.getElementById('editTitle').value = data.title;
                            document.getElementById('editCategory').value = data.categoryId;
                            document.getElementById('editISBN').value = data.isbn;
                            document.getElementById('editAuthor').value = data.author;
                            document.getElementById('editYear').value = data.publishYear;
                            document.getElementById('editPublisher').value = data.publisher;
                            document.getElementById('editExistingImage').value = data.coverImage;
                            document.getElementById('editImagePreview').src = data.coverImage;

                            // Hiện modal edit
                            const editBookModal = new bootstrap.Modal(document.getElementById('editBookModal'));
                            editBookModal.show();
                        });
                });
            }
        });
    </script>
}