@* /home/index *@

@model QuanLyThuVien.Web.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Tìm kiếm sách";
    bool isSortByTitle = Model.SortBy == "title_asc" || Model.SortBy == "title_desc";
    bool isSortByYear = Model.SortBy == "year_asc" || Model.SortBy == "year_desc";
}

<div class="container-fluid mt-3 px-4">

    <!--form tìm kiếm home/index -->
    <form asp-controller="Home" asp-action="Index" method="get" id="searchForm" class="mb-4 bg-white p-3 border-bottom shadow-sm">
        <input type="hidden" name="sortBy" value="@Model.SortBy" />

        <div class="row g-3">
            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Tên tác giả :</label>
                <input type="text" name="searchAuthor" value="@Model.SearchAuthor" class="form-control rounded-0 bg-light border-0" />
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Mã sách :</label>
                <input type="text" name="searchISBN" value="@Model.SearchISBN" class="form-control rounded-0 bg-light border-0" />
            </div>

            <div class="w-100 d-none d-md-block m-0"></div> <!-- Xuống dòng -->

            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Tên sách :</label>
                <input type="text" name="searchTitle" value="@Model.SearchTitle" class="form-control rounded-0 bg-light border-0" />
            </div>
            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Năm xuất bản :</label>
                <input type="number" name="publishYear" value="@Model.PublishYear" class="form-control rounded-0 bg-light border-0" />
            </div>

            <div class="w-100 d-none d-md-block m-0"></div> <!-- Xuống dòng -->

            <div class="col-md-5 d-flex align-items-center">
                <label class="fw-bold me-2" style="min-width: 120px;">Thể loại :</label>
                <select name="categoryId" asp-items="@Model.Categories" class="form-select rounded-0 bg-light border-0">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <div class="col-md-5 d-flex align-items-center justify-content-end gap-2">
                <button type="submit" class="btn btn-warning fw-bold px-4 rounded-0 border-0 text-dark">Tìm kiếm</button>

                <!-- button thêm sách nếu là role admin -->
                @if (User.IsInRole("Admin"))
                {
                    <button type="button" class="btn btn-success fw-bold px-4 rounded-0 border-0" data-bs-toggle="modal" data-bs-target="#addBookModal">
                        Thêm sách
                    </button>
                }
            </div>
        </div>
    </form>

    <!-- button sắp xếp -->
    <div class="d-flex align-items-center mb-4">
        <span class="fw-bold me-3">Sắp xếp :</span>
        <a href="@Url.Action("Index", new { sortBy = Model.SortBy == "title_asc" ? "title_desc" : "title_asc", searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })"
           class="badge text-white text-decoration-none p-2 me-2 fs-6 rounded-0 @(isSortByTitle ? "bg-info" : "bg-secondary")">
            Tên sách @(Model.SortBy == "title_asc" ? "↓" : Model.SortBy == "title_desc" ? "↑" : "")
        </a>
        <a href="@Url.Action("Index", new { sortBy = Model.SortBy == "year_asc" ? "year_desc" : "year_asc", searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })"
           class="badge text-white text-decoration-none p-2 fs-6 rounded-0 @(isSortByYear ? "bg-info" : "bg-secondary")">
            Năm sản xuất @(Model.SortBy == "year_asc" ? "↓" : Model.SortBy == "year_desc" ? "↑" : "")
        </a>
    </div>

    <!-- hiển thị sách -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @if (Model.Books != null && Model.Books.Items.Any())
        {
            @foreach (var book in Model.Books.Items)
            {
                <div class="col">
                    <div class="card h-100 border rounded-0 shadow-sm book-item" data-id="@book.Id" style="cursor: pointer; background-color: #f9f9f9;overflow: hidden;">

                        <!-- ảnh bìa sách -->
                        <div class="text-center pt-3" style="background: #eee9e9; background-size: cover;">
                            <img src="@(string.IsNullOrEmpty(book.CoverImage) ? "/images/no-cover.png" : book.CoverImage)"
                                 alt="@book.Title" style="height: 220px; object-fit: fill;" 
                                 class="w-100"/>
                        </div>

                        <div class="card-body bg-white border-top position-relative px-3 py-3">
                            <h5 class="card-title fw-bold text-center mb-3 text-truncate" title="@book.Title">@book.Title</h5>

                            <p class="card-text mb-1" style="font-size: 0.9rem;">Tên tác giả : @book.Author</p>
                            <p class="card-text mb-1" style="font-size: 0.9rem;">Năm xuất bản : @book.PublishYear</p>
                            <p class="card-text mb-0" style="font-size: 0.9rem;">Thể loại : @(book.Category?.Name ?? "")</p>

                            @* <!-- chỉ khách và thủ thư hiện icon giỏ hàng ở card book-->
                            @if (!User.IsInRole("Admin") && (User.IsInRole("Reader") || User.IsInRole("Librarian")))
                            {
                                <button type="button" class="btn btn-link text-dark position-absolute p-0"
                                        style="bottom: 15px; right: 20px; font-size: 1.6rem;"
                                        title="Thêm vào giỏ mượn"
                                        onclick="event.stopPropagation(); addToCart(@book.Id, '@book.Title', '@book.CoverImage')">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </button>
                            } *@
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-muted">Không tìm thấy cuốn sách nào phù hợp.</h5>
            </div>
        }
    </div>

    <!-- phân trang -->
    @if (Model.Books != null && Model.Books.TotalPages > 1)
    {
        <nav class="mt-5 mb-3 d-flex justify-content-center">
            <ul class="pagination pagination-sm border-0">
                <li class="page-item @(Model.Books.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link text-dark border-0 fs-5" href="@Url.Action("Index", new { pageNumber = Model.Books.PageNumber - 1, sortBy = Model.SortBy, searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })">&lt;&lt;</a>
                </li>
                @for (int i = 1; i <= Model.Books.TotalPages; i++)
                {
                    <li class="page-item">
                        <a class="page-link border-0 fs-5 @(i == Model.Books.PageNumber ? "fw-bold bg-transparent text-dark" : "text-dark")"
                           href="@Url.Action("Index", new { pageNumber = i, sortBy = Model.SortBy, searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Books.HasNextPage ? "" : "disabled")">
                    <a class="page-link text-dark border-0 fs-5" href="@Url.Action("Index", new { pageNumber = Model.Books.PageNumber + 1, sortBy = Model.SortBy, searchTitle = Model.SearchTitle, searchAuthor = Model.SearchAuthor, searchISBN = Model.SearchISBN, categoryId = Model.SelectedCategoryId, publishYear = Model.PublishYear })">&gt;&gt;</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- gọi modal -->
<partial name="_InfoBookModalPartial" /> <!-- modal thông tin sách -->
@if (User.IsInRole("Admin"))
{
    <partial name="_AddBookModalPartial" /><!-- modal thêm sách -->
    <partial name="_EditBookModalPartial" /><!-- modal sửa sách-->
}


<!-- ================= SCRIPTS ================= -->
@section Scripts {
    
    <script>
       

        $(document).ready(function() {
            // chỉnh sửa ảnh
            $('#imagePreviewContainer').click(function() { $('#imageInput').click(); });
            $('#imageInput').change(function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').attr('src', e.target.result).show();
                        $('#imagePreviewContainer').css('background', 'none');
                    }
                    reader.readAsDataURL(file);
                }
            });

            $('#editImagePreviewContainer').click(function() { $('#editImageInput').click(); });
            $('#editImageInput').change(function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) { $('#editImagePreview').attr('src', e.target.result); }
                    reader.readAsDataURL(file);
                }
            });

            // thêm sách
            $('#addBookForm').submit(function(e) {
                e.preventDefault();
                var formData = new FormData(this);
                $('#btnSaveBook').prop('disabled', true).text('Đang lưu...');
                $.ajax({
                    url: '/Home/AddBook', type: 'POST', data: formData, processData: false, contentType: false,
                    success: function(res) {
                        if (res.success) {
                            alert("Lưu thành công!"); location.reload();
                        } else {
                            alert("Lỗi: " + res.message); $('#btnSaveBook').prop('disabled', false).text('Lưu');
                        }
                    }
                });
            });
            // sửa sách
            $('#editBookForm').submit(function(e) {
                e.preventDefault();
                var formData = new FormData(this);
                $('#btnSaveEditBook').prop('disabled', true).text('Đang lưu...');
                $.ajax({
                    url: '/Home/EditBook', type: 'POST', data: formData, processData: false, contentType: false,
                    success: function(res) {
                        if (res.success) {
                            alert("Cập nhật sách thành công!"); location.reload();
                        } else {
                            alert("Lỗi: " + res.message); $('#btnSaveEditBook').prop('disabled', false).text('Lưu');
                        }
                    }
                });
            });

            // click vào card mở modal thông tin sách
            $('.book-item').click(function () {
                var bookId = $(this).data('id');
                $.get('/Home/GetBookDetails', { id: bookId }, function (data) {

                    // 1. Gán thông tin cơ bản
                    $('#infoBookId').val(data.id);
                    $('#infoCategory').text(data.categoryName || 'Chưa phân loại');
                    $('#infoISBN').text(data.isbn);
                    $('#infoTitle').text(data.title);
                    $('#infoAuthor').text(data.author);
                    $('#infoYear').text(data.publishYear);
                    $('#infoPublisher').text(data.publisher);
                    $('#infoLocation').text(data.suggestedLocation);

                    // 2. GÁN THÔNG TIN ERD MỚI (TỔNG SỐ VÀ KHẢ DỤNG)
                    $('#infoTotalCopies').text(data.totalCopies + ' cuốn');
                    $('#infoAvailableCopies').text(data.availableCount + ' cuốn');

                    // Khống chế ô chọn số lượng (Quantity)
                    var qtyInput = $('#infoQuantity');
                    if (qtyInput.length > 0) {
                        qtyInput.attr('max', data.availableCount); // Giới hạn tối đa
                        if (data.availableCount === 0) {
                            qtyInput.val(0).prop('disabled', true); // Hết sách thì khóa ô nhập
                        } else {
                            qtyInput.val(1).prop('disabled', false); // Còn sách thì cho nhập
                        }
                    }

                    // 3. Gán ảnh
                    var finalImg = data.coverImage ? data.coverImage : '/images/no-cover.png';
                    $('#infoImage').attr('src', finalImg);

                    // 4. Các nút thao tác của Admin / Thủ thư
                    $('#btnOpenEdit').data('id', data.id);
                    $('#btnManageCopies').attr('href', '/BookCopies/Index?bookId=' + data.id);
                    $('#btnUpdateCopiesStatus').attr('href', '/BookCopies/Index?bookId=' + data.id);

                    // Nút ẩn hiện
                    var btnToggle = $('#btnToggleVisibility');
                    btnToggle.data('id', data.id);
                    if (data.isActive) {
                        btnToggle.removeClass('btn-secondary').addClass('btn-danger').text('Ẩn sách').data('action', 'hide');
                    } else {
                        btnToggle.removeClass('btn-danger').addClass('btn-secondary').text('Hiện sách').data('action', 'show');
                    }

                    // Hiện modal
                    $('#infoBookModal').modal('show');
                }).fail(function () {
                    alert("Lỗi: Không thể lấy dữ liệu từ máy chủ.");
                });
            });
            //button ẩn hiện sách trong modal thông tin sách
            $('#btnToggleVisibility').off('click').on('click', function() {
                var bookId = $(this).data('id');
                var action = $(this).data('action');
                var url = action === 'hide' ? '/Home/HideBook' : '/Home/RestoreBook';
                var confirmMsg = action === 'hide' ? "Bạn có chắc chắn muốn ẨN cuốn sách này?" : "Bạn có chắc chắn muốn HIỆN lại cuốn sách này?";

                if (confirm(confirmMsg)) {
                    $.post(url, { id: bookId }, function(res) {
                        if (res.success) {
                            alert("Cập nhật trạng thái sách thành công!"); location.reload();
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    });
                }
            });
            //button mở modal chỉnh sửa sách
            $('#btnOpenEdit').click(function() {
                var bookId = $(this).data('id');
                $('#infoBookModal').modal('hide');

                $.get('/Home/GetBookDetails', { id: bookId }, function(data) {
                    $('#editId').val(data.id);
                    $('#editTitle').val(data.title);
                    $('#editCategory').val(data.categoryId);
                    $('#editISBN').val(data.isbn);
                    $('#editAuthor').val(data.author);
                    $('#editYear').val(data.publishYear);
                    $('#editPublisher').val(data.publisher);
                    $('#editExistingImage').val(data.coverImage);
                    $('#editImagePreview').attr('src', data.coverImage);
                    $('#editBookModal').modal('show');
                });
            });
        });


    </script>

    <!-- THẺ SCRIPT 2: Logic giỏ hàng (Chỉ load nếu đúng Role) -->
    @if (User.Identity!.IsAuthenticated && (User.IsInRole("Librarian") || User.IsInRole("Reader")))
    {
        <script>
            @* $(document).ready(function() {
                $.get('/Home/GetCartItemCount', function (count) {
                    updateCartBadge(count);
                }).fail(function() {
                    console.warn("Không thể lấy số lượng giỏ hàng.");
                });
            }); *@
            @* hàm này *@
            @* function updateCartBadge(count) {
                let badge = $('#cartItemCountBadge');
                if (badge.length > 0) {
                    badge.text(count);
                    if (count > 0) {
                        badge.css('display', 'inline-block');
                    } else {
                        badge.css('display', 'none');
                    }
                }
            } *@
        </script>
    }
}