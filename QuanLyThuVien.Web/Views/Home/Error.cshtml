@* /home/error *@

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lỗi - Thư viện</title>
    <!-- Bootstrap 5 qua CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- header màu xanh -->
    <header class="bg-primary text-white text-center py-3 fs-2">
        Thư viện
    </header>

    <!-- Nội dung căn giữa -->
    <main class="flex-grow-1 d-flex flex-column justify-content-center align-items-center" style="margin-top: -80px;">
        <!-- nội dung "error" -->
        <h1 class="display-1 text-dark mb-5" style="font-weight: 400; font-size: 6rem;">Error</h1>

        <!-- nút home -->
        <a href="/" class="btn btn-success btn-lg px-4 fs-5 rounded-1" style="background-color: #38c172; border-color: #38c172;">
            Trang chủ
        </a>
    </main>

</body>
</html>