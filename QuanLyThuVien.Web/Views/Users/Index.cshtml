@model IEnumerable<QuanLyThuVien.Web.Models.UserListViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    var currentSort = ViewBag.SortOrder as string;
}

<div class="container-fluid mt-3">
    <!-- tab menu -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Shelves" asp-action="Index">Tầng kệ sách</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Categories" asp-action="Index">Thể loại</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active fw-bold" asp-controller="Users" asp-action="Index">Người dùng</a>
        </li>
    </ul>

    <!-- Nút Thêm người dùng -->
    <div class="mb-3">
        <button type="button" class="btn btn-success text-white px-4" data-bs-toggle="modal" data-bs-target="#addUserModal">
            Thêm người dùng
        </button>
    </div>

    <!-- Form Tìm kiếm & Sắp xếp -->
    <form method="get" asp-action="Index" class="row g-3 mb-4 align-items-center">
        <div class="col-auto">
            <label class="fw-bold">Tên người dùng :</label>
        </div>
        <div class="col-md-3">
            <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control rounded-0 border bg-light" />
        </div>
        <div class="col-auto">
            <label class="fw-bold">Sắp xếp :</label>
            <a asp-action="Index" asp-route-sortOrder="@(currentSort == "name_desc" ? "" : "name_desc")" asp-route-searchName="@ViewBag.SearchName" asp-route-searchReaderId="@ViewBag.SearchReaderId" class="badge bg-info text-dark text-decoration-none p-2">
                @(currentSort == "name_desc" ? "Tên(Z-A)" : "Tên(A-Z)")
            </a>
        </div>

        <div class="w-100"></div>

        <div class="col-auto">
            <label class="fw-bold">Mã người dùng :</label>
        </div>
        <div class="col-md-3">
            <input type="text" name="searchReaderId" value="@ViewBag.SearchReaderId" class="form-control rounded-0 border bg-light" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-warning fw-bold px-4 rounded-0">Tìm kiếm</button>
        </div>
    </form>

    <!-- Bảng danh sách người dùng -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered mb-0 align-middle">
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="width: 25%;">@item.FullName</td>
                            <td style="width: 20%;">@item.Role</td>
                            <td style="width: 30%;">@(string.IsNullOrEmpty(item.ReaderId) ? "" : item.ReaderId)</td>
                            <td style="width: 12%; text-align: center;">
                                <a href="javascript:void(0);" class="text-primary text-decoration-none btn-edit"
                                   data-id="@item.Id"
                                   data-role="@(item.Role == "Khách" ? "Reader" : "Librarian")"
                                   data-readerid="@item.ReaderId">
                                   Chỉnh sửa
                                </a>
                            </td>
                            <td style="width: 13%; text-align: center;">
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link p-0 text-decoration-none @(item.IsHidden ? "text-danger" : "text-primary")">
                                        @(item.IsHidden ? "Hiện" : "Ẩn")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. MODAL THÊM NGƯỜI DÙNG -->
<!-- ========================================== -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Tên người dùng :</label>
                        <div class="col-sm-8">
                            <input type="text" name="UserName" class="form-control rounded-0 bg-light" required />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Mật khẩu :</label>
                        <div class="col-sm-8">
                            <input type="password" name="Password" class="form-control rounded-0 bg-light" required />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Vai trò :</label>
                        <div class="col-sm-8">
                            <select name="Role" id="addRoleSelect" class="form-select rounded-0 bg-light" required>
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Reader">Khách</option>
                                <option value="Librarian">Thủ thư</option>
                            </select>
                        </div>
                    </div>
                    <!-- Ô mã người dùng ẩn/hiện dựa vào Role -->
                    <div class="mb-3 row align-items-center" id="addReaderIdGroup" style="display: none;">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Mã người dùng :</label>
                        <div class="col-sm-8">
                            <input type="text" name="ReaderId" class="form-control rounded-0 bg-light" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="submit" class="btn btn-success text-white px-5 rounded-0">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. MODAL CHỈNH SỬA NGƯỜI DÙNG -->
<!-- ========================================== -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Chỉnh sửa người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editUserId" />
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Mật khẩu :</label>
                        <div class="col-sm-8">
                            <input type="password" name="Password" class="form-control rounded-0 bg-light" placeholder="Để trống nếu không đổi" />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Vai trò :</label>
                        <div class="col-sm-8">
                            <select name="Role" id="editRoleSelect" class="form-select rounded-0 bg-light" required>
                                <option value="Reader">Khách</option>
                                <option value="Librarian">Thủ thư</option>
                            </select>
                        </div>
                    </div>
                    <!-- Ô mã người dùng ẩn/hiện dựa vào Role khi sửa -->
                    <div class="mb-3 row align-items-center" id="editReaderIdGroup" style="display: none;">
                        <label class="col-sm-4 col-form-label text-end fw-bold">Mã người dùng :</label>
                        <div class="col-sm-8">
                            <input type="text" name="ReaderId" id="editReaderIdInput" class="form-control rounded-0 bg-light" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="submit" class="btn btn-success text-white px-5 rounded-0">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // hàm ẩn hiện ô nhập mã người dùng theo role trong modal thêm người dùng
        $('#addRoleSelect').change(function () {
            if ($(this).val() === 'Reader') {
                $('#addReaderIdGroup').show(); //nếu role là reader thì hiện ô nhập mã
            } else {
                $('#addReaderIdGroup').hide();
                $('#addReaderIdGroup input').val(''); // Clear giá trị nếu ẩn
            }
        });

        // hàm ẩn hiện ô nhập mã người dùng theo role trong modal sửa người dùng
        $('#editRoleSelect').change(function () {
            if ($(this).val() === 'Reader') {
                $('#editReaderIdGroup').show(); //nếu role là reader thì hiện ô nhập mã
            } else {
                $('#editReaderIdGroup').hide();
                $('#editReaderIdInput').val(''); // Clear giá trị nếu ẩn
            }
        });

        // hàm khi bấm nút chỉnh sửa trong users/index , lấy dữ liệu của người dùng hiện tại gán vào các ô của modal sửa
        $('.btn-edit').click(function () {
            var id = $(this).data('id');
            var role = $(this).data('role');
            var readerId = $(this).data('readerid');

            $('#editUserId').val(id);
            $('#editRoleSelect').val(role).trigger('change'); // trigger để chạy sự kiện show/hide ô mã
            $('#editReaderIdInput').val(readerId);

            // Hiển thị modal chỉnh sửa
            var editModal = new bootstrap.Modal(document.getElementById('editUserModal'));
            editModal.show();
        });
    </script>
}