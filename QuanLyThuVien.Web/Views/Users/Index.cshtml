@* /user/index *@

@model IEnumerable<QuanLyThuVien.Web.Models.UserListViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
    var currentSort = ViewBag.SortOrder as string;
}

<div class="container-fluid mt-3">
    <!-- tab menu -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Shelves" asp-action="Index">Tầng kệ sách</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Categories" asp-action="Index">Thể loại</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active fw-bold" asp-controller="Users" asp-action="Index">Người dùng</a>
        </li>
    </ul>

    <div class="mb-3">
        <button type="button" class="btn btn-success text-white px-4 rounded-0" data-bs-toggle="modal" data-bs-target="#addUserModal">
            Thêm người dùng
        </button>
    </div>

    <!-- Form Tìm kiếm & Sắp xếp -->
    <form method="get" asp-action="Index" class="row g-3 mb-4 align-items-end">
        <div class="col-12 col-md-3">
            <label class="fw-bold mb-1">Tên người dùng :</label>
            <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control rounded-0 border bg-light" />
        </div>
        <div class="col-12 col-md-3">
            <label class="fw-bold mb-1">Mã định danh :</label>
            <input type="text" name="searchUserCode" value="@ViewBag.SearchUserCode" class="form-control rounded-0 border bg-light" />
        </div>
        <div class="col-12 col-md-auto">
            <label class="fw-bold me-2 mb-1 d-block d-md-inline">Sắp xếp :</label>
            <a asp-action="Index" asp-route-sortOrder="@(currentSort == "name_desc" ? "" : "name_desc")" asp-route-searchName="@ViewBag.SearchName" asp-route-searchUserCode="@ViewBag.SearchUserCode" class="badge bg-info text-dark text-decoration-none p-2 mt-1 mt-md-0">
                @(currentSort == "name_desc" ? "Tên (Z-A)" : "Tên (A-Z)")
            </a>
        </div>
        <div class="col-12 col-md-auto text-end text-md-start">
            <button type="submit" class="btn btn-warning fw-bold px-4 rounded-0 w-100 w-md-auto">Tìm kiếm</button>
        </div>
    </form>

    <!-- Bảng danh sách người dùng -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle">
                    <thead class="table-light text-center fw-bold text-nowrap">
                        <tr>
                            <th>Tên đăng nhập</th>
                            <th>Vai trò</th>
                            <th>Mã định danh</th>
                            <th>Chức vụ / Lớp</th>
                            <th>Thao tác</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-nowrap">@item.FullName</td>
                                <td class="text-center text-nowrap">@item.Role</td>
                                <td class="text-center text-nowrap">@(string.IsNullOrEmpty(item.UserCode) ? "" : item.UserCode)</td>
                                <td class="text-center text-nowrap">@(string.IsNullOrEmpty(item.Position) ? "" : item.Position)</td>
                                <td class="text-center text-nowrap">
                                    <a href="javascript:void(0);" class="text-primary text-decoration-none btn-edit"
                                       data-id="@item.Id"
                                       data-role="@(item.Role == "Khách" ? "Reader" : "Librarian")"
                                       data-usercode="@item.UserCode"
                                       data-position="@item.Position">
                                        Chỉnh sửa
                                    </a>
                                </td>
                                <td class="text-center text-nowrap">
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-link p-0 text-decoration-none fw-bold @(item.IsHidden ? "text-danger" : "text-success")">
                                            @(item.IsHidden ? "Khóa" : "Mở")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL thêm người dùng-->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Tên đăng nhập :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" name="UserName" class="form-control rounded-0 bg-light" required />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Mật khẩu :</label>
                        <div class="col-12 col-md-8">
                            <input type="password" name="Password" class="form-control rounded-0 bg-light" required />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Vai trò :</label>
                        <div class="col-12 col-md-8">
                            <select name="Role" id="addRoleSelect" class="form-select rounded-0 bg-light" required>
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Reader">Khách</option>
                                <option value="Librarian">Thủ thư</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center" id="addUserCodeGroup">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Mã định danh :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" name="UserCode" class="form-control rounded-0 bg-light" placeholder="Nhập mã NV/Thẻ..." />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Chức vụ / Lớp :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" name="Position" class="form-control rounded-0 bg-light" placeholder="Nhập Lớp hoặc Chức vụ..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="submit" class="btn btn-success text-white px-5 rounded-0">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL chỉnh sửa người dùng -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Chỉnh sửa người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" name="Id" id="editUserId" />
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Mật khẩu :</label>
                        <div class="col-12 col-md-8">
                            <input type="password" name="Password" class="form-control rounded-0 bg-light" placeholder="Để trống nếu không đổi" />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Vai trò :</label>
                        <div class="col-12 col-md-8">
                            <select name="Role" id="editRoleSelect" class="form-select rounded-0 bg-light" required>
                                <option value="Reader">Khách</option>
                                <option value="Librarian">Thủ thư</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center" id="editUserCodeGroup">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Mã định danh :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" name="UserCode" id="editUserCodeInput" class="form-control rounded-0 bg-light" placeholder="Nhập mã NV/Thẻ..." />
                        </div>
                    </div>
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Chức vụ / Lớp :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" name="Position" id="editPositionInput" class="form-control rounded-0 bg-light" placeholder="Nhập Lớp hoặc Chức vụ..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="submit" class="btn btn-success text-white px-5 rounded-0">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.btn-edit').click(function () {
            var id = $(this).data('id');
            var role = $(this).data('role');
            var userCode = $(this).data('usercode');
            var position = $(this).data('position');

            $('#editUserId').val(id);
            $('#editRoleSelect').val(role).trigger('change');
            $('#editUserCodeInput').val(userCode);
            $('#editPositionInput').val(position);

            new bootstrap.Modal(document.getElementById('editUserModal')).show();
        });
    </script>
}