@* /carts/Index.cshtml *@

@model IEnumerable<QuanLyThuVien.Web.Entities.CartItems>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container py-5" style="max-width: 800px;">
    @Html.AntiForgeryToken()

    <!-- Tiêu đề -->
    <div class="text-center mb-4">
        <h2 class="fw-bold">Giỏ hàng mượn sách</h2>
    </div>

    <!-- Danh sách sản phẩm trong giỏ -->
    <div id="cartItemsContainer">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="card border-0 shadow-sm mb-3 align-items-center flex-row p-3 cart-row" id="cart-item-@item.Id" style="background-color: #ffffff;">
                    <!-- Ảnh bìa sách -->
                    <div class="text-center me-4" style="width: 100px; height: 120px; background-image: url('/images/transparent-grid.png'); background-size: cover;">
                        <img src="@(string.IsNullOrEmpty(item.Book?.CoverImage) ? "/images/no-cover.png" : item.Book.CoverImage)"
                             alt="@item.Book?.Title" class="img-fluid h-100 border shadow-sm" style="object-fit: contain;" />
                    </div>

                    <!-- Tên sách và Thông tin -->
                    <div class="flex-grow-1 ps-2">
                        <h5 class="fw-bold mb-1 text-primary">@(item.Book?.Title ?? "Tên sách")</h5>
                        
                        <div class="text-muted mt-2" style="font-size: 0.95rem;">
                            <!-- Hiển thị Tên người mượn và Số lượng -->
                            Người mượn: <strong class="text-dark">@(item.User?.UserName ?? User.Identity?.Name ?? "Bạn")</strong> <br/>
                            Số lượng mượn: <strong class="text-danger fs-6">@item.Quantity</strong> cuốn
                        </div>
                    </div>

                    <!-- Nút Xóa -->
                    <div>
                        <button type="button" class="btn btn-outline-danger px-4 py-2 rounded-0 fw-bold"
                        style="height:40px; align-self:center; display:flex; align-items:center; gap:6px;"
                                onclick="removeItem(@item.Id)">
                            <i class="fa-solid fa-trash-can"></i> Xóa
                        </button>
                    </div>
                </div>
            }

            <!-- Khu vực Thủ thư/Admin nhập tên người mượn hộ -->
            @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
            {
                <div class="mt-4 p-3 bg-light border rounded shadow-sm">
                    <label class="form-label fw-bold">Tên đăng nhập (Username) của người mượn:</label>
                    <input type="text" id="targetUsername" class="form-control rounded-0" placeholder="Nhập username độc giả (để trống nếu tự mượn cho mình)">
                </div>
            }

            <!-- Nút Tạo phiếu mượn -->
            <div class="text-center mt-5">
                <button type="button" id="btnCreateTicket" class="btn btn-success px-5 py-3 rounded-0 border-0 fw-bold fs-5 text-white shadow-sm" onclick="createBorrowTicket()">
                    <i class="fa-solid fa-check me-2"></i> Xác nhận mượn sách
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5 class="text-muted mb-4">Giỏ hàng của bạn đang trống.</h5>
                <a href="/Home/Index" class="btn btn-warning rounded-0 px-4 py-2 fw-bold text-dark">
                    <i class="fa-solid fa-arrow-left me-2"></i> Quay lại tìm kiếm sách
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // 1. Hàm xóa sản phẩm khỏi giỏ hàng
        function removeItem(cartId) {
            if (confirm("Bạn có chắc chắn muốn xóa cuốn sách này khỏi giỏ hàng?")) {                
                // Lấy Token bảo mật
                var token = $('input[name="__RequestVerificationToken"]').val();
                
                $.ajax({
                    url: '/Cart/RemoveItem',
                    type: 'POST',
                    data: { 
                        id: cartId,
                        __RequestVerificationToken: token // Truyền token vào data
                    },
                    success: function (res) {
                        if (res.success) {
                            $('#cart-item-' + cartId).fadeOut(300, function() { 
                                $(this).remove(); 
                                // Nếu xóa hết sạch item thì reload lại trang
                                if ($('.cart-row').length === 0) {
                                    location.reload();
                                }
                            });                            
                            
                            // Cập nhật lại số đếm ở Header
                            $.get('/Home/GetCartItemCount', function (count) {
                                let badge = $('#cartItemCountBadge');
                                if (badge.length > 0) {
                                    badge.text(count);
                                    badge.css('display', count > 0 ? 'inline-block' : 'none');
                                }
                            });
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    },
                    error: function (xhr) {
                        alert("Không thể kết nối đến máy chủ. Mã lỗi: " + xhr.status);
                    }
                });
            }
        }

        // 2. Hàm tạo phiếu mượn
        function createBorrowTicket() {
            var token = $('input[name="__RequestVerificationToken"]').val();
            // Nếu có ô input targetUsername (dành cho thủ thư) thì lấy giá trị, không thì để rỗng
            var targetUser = $('#targetUsername').length ? $('#targetUsername').val() : '';

            $('#btnCreateTicket').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Đang xử lý...');            
            
            $.ajax({
                url: '/Cart/CreateTicket', // Gọi vào hàm CreateTicket trong CartController
                type: 'POST',
                data: {
                    targetUsername: targetUser,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        window.location.href = '/BorrowTickets/Index'; // Chuyển sang trang xem Phiếu mượn
                    } else {
                        alert(res.message);
                        $('#btnCreateTicket').prop('disabled', false).html('<i class="fa-solid fa-check me-2"></i> Xác nhận mượn sách');
                    }
                },
                error: function (xhr) {
                    alert("Yêu cầu bị từ chối! (Mã lỗi: " + xhr.status + ")");
                    $('#btnCreateTicket').prop('disabled', false).html('<i class="fa-solid fa-check me-2"></i> Xác nhận mượn sách');
                }
            });
        }
    </script>
}