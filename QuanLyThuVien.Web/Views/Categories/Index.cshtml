@* /categories/index.cshtml *@

@model IEnumerable<QuanLyThuVien.Web.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Quản lý thể loại";
}

<div class="container-fluid mt-3">
    <!-- Tab menu phía trên -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Shelves" asp-action="Index">Tầng kệ sách</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active fw-bold" asp-controller="Categories" asp-action="Index">Thể loại</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Người dùng</a>
        </li>
    </ul>

    <!-- Nút Mở Modal Thêm Thể Loại -->
    <div class="mb-3">
        <button type="button" class="btn btn-success text-white px-4 rounded-0" onclick="openAddModal()">
            Thêm thể loại
        </button>
    </div>

    <!-- Form Tìm kiếm  -->
    <form method="get" asp-action="Index" class="row g-3 mb-4 align-items-center">
        <div class="col-12 col-md-auto">
            <label class="fw-bold mb-0">Tên thể loại :</label>
        </div>
        <div class="col-12 col-md-3">
            <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control rounded-0 border bg-light" />
        </div>
        <div class="col-12 col-md-auto mt-2 mt-md-0">
            <button type="submit" class="btn btn-warning fw-bold px-4 rounded-0 w-100 w-md-auto">Tìm kiếm</button>
        </div>
    </form>

    <!-- Bảng danh sách thể loại -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle">
                    <thead class="table-light text-nowrap">
                        <tr>
                            <th>Tên thể loại</th>
                            <th class="text-center">Thao tác</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold ps-4 text-nowrap">@item.Name</td>
                                <td class="text-center text-nowrap">
                                    <a href="javascript:void(0);" class="text-primary text-decoration-none"
                                       onclick="openEditModal(@item.Id, '@item.Name')">Chỉnh sửa</a>
                                </td>
                                <td class="text-center text-nowrap">
                                    <a href="javascript:void(0);" class="text-decoration-none @(item.IsActive ? "text-danger" : "text-success")"
                                       onclick="toggleStatus(@item.Id)">@(item.IsActive ? "Ẩn" : "Hiện")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm / Sửa Thể Loại -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalTitle">Thêm thể loại</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="categoryForm">
                <input type="hidden" id="CategoryId" name="id" value="0" />
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Tên thể loại :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" id="CategoryName" name="name" class="form-control rounded-0 bg-light" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="submit" class="btn btn-success text-white px-5 rounded-0">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hàm reset form và mở modal Thêm mới
        function openAddModal() {
            document.getElementById('CategoryId').value = 0;
            document.getElementById('CategoryName').value = '';
            document.getElementById('modalTitle').textContent = 'Thêm thể loại';

            // Sử dụng Bootstrap 5 Modal API
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }

        // Hàm đổ dữ liệu và mở modal Chỉnh sửa
        function openEditModal(id, name) {
            document.getElementById('CategoryId').value = id;
            document.getElementById('CategoryName').value = name;
            document.getElementById('modalTitle').textContent = 'Chỉnh sửa thể loại';

            // Sử dụng Bootstrap 5 Modal API
            new bootstrap.Modal(document.getElementById('categoryModal')).show();
        }

        // Thay đổi trạng thái (Ẩn/Hiện)
        function toggleStatus(id) {
            fetch('/Categories/ToggleCategoryStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                // Gom dữ liệu id để gửi đi
                body: new URLSearchParams({ id: id }).toString()
            })
                .then(response => response.json())
                .then(response => {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        // Đảm bảo DOM đã tải xong trước khi gắn sự kiện
        document.addEventListener('DOMContentLoaded', function() {

            // Xử lý Submit Form
            const categoryForm = document.getElementById('categoryForm');
            if (categoryForm) {
                categoryForm.addEventListener('submit', function(e) {
                    e.preventDefault(); // Ngăn chặn hành vi submit mặc định của form

                    // Gom toàn bộ dữ liệu trong form (tương đương $(this).serialize())
                    const formData = new URLSearchParams(new FormData(this)).toString();

                    fetch('/Categories/SaveCategory', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: formData
                    })
                        .then(response => response.json())
                        .then(response => {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            }
        });
    </script>
}