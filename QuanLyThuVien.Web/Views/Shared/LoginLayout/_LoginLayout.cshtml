<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện</title>

    <!-- Bootstrap 5 CSS CDN  -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- header nền xanh dương , chữ trắng , căn giữa  -->
    <header class="bg-primary text-white text-center py-3 shadow-sm">
        <div class="container">
            <h1 class="h2 mb-0 fw-normal">Thư viện</h1>
        </div>
    </header>

    <!-- nội dung chính -->
    <main role="main" class="container my-5 flex-grow-1">
        @RenderBody()
    </main>

    <!-- footer nền tráng , chữ căn giữa -->
    <footer class="bg-white text-center py-3 text-muted border-top mt-auto small">
        <div class="container">
            &copy; 2026 - Hệ thống Quản lý Thư viện
        </div>
    </footer>
    <!--Bootstrap 5 JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!--script -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>