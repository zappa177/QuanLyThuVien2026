@* _InfoBookModalPartial *@

<div class="modal fade" id="infoBookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="background-color: #f4f4f4;">
            <div class="modal-body p-4 position-relative">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
                <h5 class="text-center mb-4">Thông tin sách</h5>

                <!-- lưu id của sách ẩn để thao tác lưu -->
                <input type="hidden" id="infoBookId" value="" />

                <div class="row mb-2"><label class="col-5 text-end mb-0 text-muted">Thể loại :</label><div class="col-7 fw-bold" id="infoCategory"></div></div>
                <div class="row mb-2"><label class="col-5 text-end mb-0 text-muted">Mã sách (ISBN) :</label><div class="col-7 fw-bold" id="infoISBN"></div></div>
                <div class="row mb-2"><label class="col-5 text-end mb-0 text-muted">Tên sách :</label><div class="col-7 fw-bold" id="infoTitle"></div></div>
                <div class="row mb-2"><label class="col-5 text-end mb-0 text-muted">Tác giả :</label><div class="col-7 fw-bold" id="infoAuthor"></div></div>
                <div class="row mb-2"><label class="col-5 text-end mb-0 text-muted">Năm XB :</label><div class="col-7 fw-bold" id="infoYear"></div></div>
                <div class="row mb-2"><label class="col-5 text-end mb-0 text-muted">Nhà XB :</label><div class="col-7 fw-bold" id="infoPublisher"></div></div>

                <!-- Hiển thị số lượng -->
                <hr class="my-2 text-muted" />
                <div class="row mb-2">
                    <label class="col-5 text-end mb-0 text-dark fw-bold">Tổng số bản sao :</label>
                    <div class="col-7 fw-bold text-primary fs-5" id="infoTotalCopies">0</div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 text-end mb-0 text-dark fw-bold">Có thể mượn :</label>
                    <div class="col-7 fw-bold text-success fs-5" id="infoAvailableCopies">0</div>
                </div>

                <div class="text-center mt-3 mb-3">
                    <img id="infoImage" src="" style="width: 80%; height: 200px; object-fit: contain; border: 1px dashed #ccc;" />
                </div>

                <!-- CÁC NÚT PHÂN QUYỀN THEO ROLE  -->
                <div class="text-center mt-4 mb-3">

                    @if (User.IsInRole("Admin"))
                    {
                        <!-- CÁC NÚT DÀNH RIÊNG CHO ADMIN -->
                        <div class="d-flex justify-content-center gap-2">
                            <a href="#" id="btnManageCopies" class="btn btn-primary px-3 py-2 rounded-0 border-0">Quản lý bản sao</a>
                            <button type="button" class="btn btn-warning px-3 py-2 rounded-0 border-0" id="btnOpenEdit">Chỉnh sửa</button>
                            <button type="button" class="btn btn-danger px-3 py-2 rounded-0 border-0" id="btnToggleVisibility">Ẩn sách</button>
                        </div>
                    }
                    else if (User.IsInRole("Librarian") || User.IsInRole("Reader"))
                    {
                        <!-- CÁC NÚT DÀNH CHO THỦ THƯ VÀ KHÁCH -->
                        <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                            <label class="fw-bold mb-0">Số lượng:</label>
                            <!-- Ô nhập số lượng mượn -->
                            <input type="number" id="infoQuantity" class="form-control text-center" value="1" min="1" style="width: 80px;" />

                            <button type="button" class="btn btn-success px-4 py-2 rounded-0 border-0 text-white" onclick="addToCartFromModal()">
                                Thêm giỏ hàng
                            </button>
                        </div>

                        <!-- Thủ thư có thêm nút đi đến trang Quản lý bản sao -->
                        @if (User.IsInRole("Librarian"))
                        {
                            <div>
                                <a href="#" id="btnUpdateCopiesStatus" class="btn btn-info px-4 py-2 rounded-0 border-0 text-white w-100">
                                    Cập nhật tình trạng bản sao
                                </a>
                            </div>
                        }
                    }
                </div>

            </div>
        </div>
    </div>
</div>