<!--tab quản lý trong quản lý thông tin của admin-->
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<ul class="nav nav-tabs border-bottom-0 mb-3" style="gap: 2px;">
    <!-- Tab 1: Gộp Kệ & Tầng kệ -->
    <li class="nav-item">
        <a asp-controller="Shelves" asp-action="Index"
           class="nav-link rounded-0 border text-dark @(currentController == "Shelves" ? "bg-primary text-white border-primary" : "bg-white")">
            Kệ sách & Tầng
        </a>
    </li>

    <!-- Tab 2: Thể loại -->
    <li class="nav-item">
        <a asp-controller="Categories" asp-action="Index"
           class="nav-link rounded-0 border text-dark @(currentController == "Categories" ? "bg-primary text-white border-primary" : "bg-white")">
            Thể loại
        </a>
    </li>

    <!-- Tab 3: Người dùng -->
    <li class="nav-item">
        <a asp-controller="Users" asp-action="Index"
           class="nav-link rounded-0 border text-dark @(currentController == "Users" ? "bg-primary text-white border-primary" : "bg-white")">
            Người dùng
        </a>
    </li>
</ul>