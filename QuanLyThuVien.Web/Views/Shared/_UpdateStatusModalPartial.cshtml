<!-- Modal phần cập nhật tình trạng sách của thủ thư-->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-0 border-0" style="background-color: #f4f4f4;">

            <!-- Header (có nút close modal) -->
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center pt-2 pb-4">
                <input type="hidden" id="updateStatusBookId" />

                <!-- dropdown tình trạng -->
                <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
                    <label class="form-label fw-bold mb-0 fs-5 text-dark">Tình trạng :</label>
                    <select id="bookStatusSelect" class="form-select rounded-0 border-0 bg-white" style="width: 140px; box-shadow: none;">
                        <option value="Sẵn sàng">Sẵn sàng</option>
                        <option value="Đang mượn">Đang mượn</option>
                        <option value="Hư hỏng">Hư hỏng</option>
                        <option value="Mất">Mất</option>
                    </select>
                </div>

                <!-- Nút lưu -->
                <button type="button" class="btn btn-success px-5 py-2 rounded-0 text-white fs-5" onclick="saveBookStatus()">
                    Lưu
                </button>
            </div>

        </div>
    </div>
</div>