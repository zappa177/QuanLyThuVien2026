@* _EditBookModalPartial *@

@using QuanLyThuVien.Web.Enums
<!-- modal chỉnh sửa sách cho admin-->
@if (User.IsInRole("Admin"))
{
    <div class="modal fade" id="editBookModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0" style="background-color: #f4f4f4;">
                <div class="modal-body p-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
                    <h5 class="text-center mb-4">Thông tin sách</h5>
                    <form id="editBookForm" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" id="editId" />
                        <input type="hidden" name="ExistingCoverImage" id="editExistingImage" />

                        <!-- form như thêm sách -->
                        <div class="row mb-2 align-items-center">
                            <label class="col-4 text-end mb-0">Tên sách :</label>
                            <div class="col-8"><input type="text" name="Title" id="editTitle" class="form-control form-control-sm border-0 rounded-0" required /></div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <label class="col-4 text-end mb-0">Thể loại :</label>
                            <div class="col-8">
                                <select name="CategoryId" id="editCategory" class="form-select form-select-sm border-0 rounded-0" asp-items="ViewBag.Categories" required></select>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <label class="col-4 text-end mb-0">Mã sách :</label>
                            <div class="col-8"><input type="text" name="ISBN" id="editISBN" class="form-control form-control-sm border-0 rounded-0" required /></div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <label class="col-4 text-end mb-0">Tác giả :</label>
                            <div class="col-8"><input type="text" name="Author" id="editAuthor" class="form-control form-control-sm border-0 rounded-0" required /></div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <label class="col-4 text-end mb-0">Năm xuất bản :</label>
                            <div class="col-8"><input type="number" name="PublishYear" id="editYear" class="form-control form-control-sm border-0 rounded-0" required /></div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <label class="col-4 text-end mb-0">Nhà xuất bản :</label>
                            <div class="col-8"><input type="text" name="Publisher" id="editPublisher" class="form-control form-control-sm border-0 rounded-0" required /></div>
                        </div>

                        <div class="text-center mt-4 mb-3"> <!--phần chọn ảnh bìa-->
                            <input type="file" id="editImageInput" name="CoverImage" class="d-none" accept="image/*" />
                            <div id="editImagePreviewContainer" style="cursor: pointer; display: inline-block; width: 80%; height: 200px; border: 1px dashed #ccc;" title="Bấm để đổi ảnh">
                                <img id="editImagePreview" src="" style="width: 100%; height: 100%; object-fit: contain;" />
                            </div>
                        </div>
                        <!--lưu-->
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success px-5 rounded-0 border-0" id="btnSaveEditBook">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}