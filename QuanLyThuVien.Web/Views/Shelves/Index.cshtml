@* /shelves/Index.cshtml *@

@model IEnumerable<QuanLyThuVien.Web.Entities.Shelves>

@{
    ViewData["Title"] = "Quản lý tầng kệ sách";
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentSort = ViewBag.CurrentSort as string;
}

<div class="container-fluid mt-3">
    <!-- Tab menu phía trên -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active fw-bold" asp-controller="Shelves" asp-action="Index">Tầng kệ sách</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Categories" asp-action="Index">Thể loại</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Người dùng</a>
        </li>
    </ul>

    <!-- Nút Thêm kệ sách -->
    <div class="mb-3">
        <button type="button" class="btn btn-success text-white px-4 rounded-0" onclick="openAddShelfModal()">
            Thêm kệ sách
        </button>
    </div>

    <!-- Form Tìm kiếm  -->
    <form method="get" asp-action="Index" class="row g-3 mb-4 align-items-center">
        <div class="col-12 col-md-auto">
            <label class="fw-bold mb-0">Tên kệ :</label>
        </div>
        <div class="col-12 col-md-3">
            <input type="text" name="searchString" value="@currentSearch" class="form-control rounded-0 border bg-light" />
        </div>
        <div class="col-12 col-md-auto mt-2 mt-md-0">
            <label class="fw-bold me-2">Sắp xếp :</label>
            <a asp-action="Index" asp-route-sortOrder="@(currentSort == "name_asc" ? "name_desc" : "name_asc")" asp-route-searchString="@currentSearch" class="badge bg-info text-dark text-decoration-none p-2">
                @(currentSort == "name_asc" ? "Tên (A-Z)" : "Tên (Z-A)")
            </a>
        </div>
        <div class="col-12 col-md-auto mt-2 mt-md-0">
            <button type="submit" class="btn btn-warning fw-bold px-4 rounded-0 w-100 w-md-auto">Tìm kiếm</button>
        </div>
    </form>

    <!-- Bảng danh sách kệ sách -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0 align-middle">
                    <thead class="table-light text-nowrap">
                        <tr>
                            <th>Tên kệ</th>
                            <th class="text-center">Quản lý tầng</th>
                            <th class="text-center">Thao tác</th>
                            <th class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shelf in Model)
                        {
                            var activeTiersCount = shelf.ShelfTiers?.Count(t => t.IsActive) ?? 0;
                            <tr>
                                <td class="fw-bold ps-4">
                                    @shelf.Name (@activeTiersCount tầng)
                                </td>
                                <td class="text-center text-nowrap">
                                    <a href="javascript:void(0);" class="text-primary text-decoration-none"
                                       onclick="openManageTierModal(@shelf.Id, '@shelf.Name')">Quản lý tầng</a>
                                </td>
                                <td class="text-center text-nowrap">
                                    <a href="javascript:void(0);" class="text-primary text-decoration-none"
                                       onclick="openEditShelfModal(@shelf.Id, '@shelf.Name')">Chỉnh sửa</a>
                                </td>
                                <td class="text-center text-nowrap">
                                    <a href="javascript:void(0);" class="text-decoration-none @(shelf.IsActive ? "text-danger" : "text-success")"
                                       onclick="toggleShelfStatus(@shelf.Id)">@(shelf.IsActive ? "Ẩn" : "Hiện")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- modal thêm sửa kệ sách -->
<div class="modal fade" id="shelfModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="shelfModalTitle">Thêm kệ sách</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="shelfForm">
                <input type="hidden" id="ShelfId" name="id" value="0" />
                <div class="modal-body">
                    <div class="mb-3 row align-items-center">
                        <label class="col-12 col-md-4 col-form-label text-md-end fw-bold">Tên kệ :</label>
                        <div class="col-12 col-md-8">
                            <input type="text" id="ShelfName" name="name" class="form-control rounded-0 bg-light" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="submit" class="btn btn-success text-white px-5 rounded-0">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- modal quản lý tầng -->
<div class="modal fade" id="manageTierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="modalShelfTitle">Quản lý tầng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="tierForm" class="row g-3 align-items-end mb-4 p-3 bg-light border">
                    <input type="hidden" id="TierId" name="id" value="0" />
                    <input type="hidden" id="ModalShelfId" name="shelfId" value="" />

                    <div class="col-12 col-md-5">
                        <label class="fw-bold form-label">Tên tầng (VD: Tầng 1)</label>
                        <input type="text" id="TierName" name="tierName" class="form-control rounded-0" required />
                    </div>
                    <div class="col-12 col-md-4 mt-2 mt-md-0">
                        <label class="fw-bold form-label">Giới hạn sách</label>
                        <input type="number" id="Capacity" name="capacity" class="form-control rounded-0" value="50" min="1" required />
                    </div>
                    <div class="col-12 col-md-3 mt-3 mt-md-0 text-end">
                        <button type="submit" class="btn btn-success rounded-0 w-100">Lưu thông tin</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light text-nowrap">
                            <tr>
                                <th>Tên tầng</th>
                                <th>Sức chứa</th>
                                <th>Đang xếp</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tierTableBody">
                            <!-- Data -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mở modal thêm kệ sách
        function openAddShelfModal() {
            document.getElementById('ShelfId').value = 0;
            document.getElementById('ShelfName').value = '';
            document.getElementById('shelfModalTitle').textContent = 'Thêm kệ sách';

            new bootstrap.Modal(document.getElementById('shelfModal')).show();
        }

        // Mở modal chỉnh sửa kệ sách
        function openEditShelfModal(id, name) {
            document.getElementById('ShelfId').value = id;
            document.getElementById('ShelfName').value = name;
            document.getElementById('shelfModalTitle').textContent = 'Chỉnh sửa kệ sách';

            new bootstrap.Modal(document.getElementById('shelfModal')).show();
        }

        // Thay đổi trạng thái kệ sách (Ẩn/Hiện)
        function toggleShelfStatus(id) {
            fetch('/Shelves/ToggleShelfStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: new URLSearchParams({ id: id }).toString()
            })
                .then(response => response.json())
                .then(response => {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        // Mở modal quản lý tầng
        function openManageTierModal(shelfId, shelfName) {
            document.getElementById('ModalShelfId').value = shelfId;
            document.getElementById('modalShelfTitle').textContent = 'Quản lý tầng - ' + shelfName;

            resetTierForm();
            loadTiers(shelfId);

            new bootstrap.Modal(document.getElementById('manageTierModal')).show();
        }

        // Tải danh sách các tầng
        function loadTiers(shelfId) {
            fetch('/Shelves/GetTiersByShelf?shelfId=' + encodeURIComponent(shelfId))
                .then(response => response.json())
                .then(data => {
                    let rows = '';
                    data.tiers.forEach(function(tier) {
                        const actionText = tier.isActive ? "Ẩn" : "Hiện";
                        const actionClass = tier.isActive ? "text-danger" : "text-success";

                        rows += `<tr>
                                        <td class="fw-bold">${tier.tierName}</td>
                                        <td>${tier.capacity}</td>
                                        <td>${tier.currentBooks} / ${tier.capacity}</td>
                                        <td>
                                            <a href="javascript:void(0);" class="text-primary text-decoration-none me-2" onclick="editTier(${tier.id}, '${tier.tierName}', ${tier.capacity})">Sửa</a>
                                            <a href="javascript:void(0);" class="${actionClass} text-decoration-none" onclick="toggleTierStatus(${tier.id}, ${shelfId})">${actionText}</a>
                                        </td>
                                    </tr>`;
                    });
                    document.getElementById('tierTableBody').innerHTML = rows;
                })
                .catch(error => console.error('Error:', error));
        }

        // Đổ dữ liệu vào form sửa tầng
        function editTier(id, name, capacity) {
            document.getElementById('TierId').value = id;
            document.getElementById('TierName').value = name;
            document.getElementById('Capacity').value = capacity;
        }

        // Đặt lại form tầng
        function resetTierForm() {
            document.getElementById('TierId').value = 0;
            document.getElementById('TierName').value = '';
            document.getElementById('Capacity').value = 50;
        }

        // Thay đổi trạng thái tầng (Ẩn/Hiện)
        function toggleTierStatus(tierId, shelfId) {
            fetch('/Shelves/ToggleTierStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: new URLSearchParams({ id: tierId }).toString()
            })
                .then(response => response.json())
                .then(response => {
                    if (response.success) {
                        loadTiers(shelfId);
                    } else {
                        alert(response.message);
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        // Gắn sự kiện submit cho các form sau khi DOM đã sẵn sàng
        document.addEventListener('DOMContentLoaded', function() {

            // Xử lý submit form thêm/sửa kệ sách
            const shelfForm = document.getElementById('shelfForm');
            if (shelfForm) {
                shelfForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = new URLSearchParams(new FormData(this)).toString();

                    fetch('/Shelves/SaveShelf', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: formData
                    })
                        .then(response => response.json())
                        .then(response => {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert(response.message);
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            }

            // Xử lý submit form thêm/sửa tầng
            const tierForm = document.getElementById('tierForm');
            if (tierForm) {
                tierForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const formData = new URLSearchParams(new FormData(this)).toString();

                    fetch('/Shelves/SaveTier', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: formData
                    })
                        .then(response => response.json())
                        .then(response => {
                            if (response.success) {
                                loadTiers(document.getElementById('ModalShelfId').value);
                                resetTierForm();
                            } else {
                                alert(response.message);
                            }
                        })
                        .catch(error => console.error('Error:', error));
                });
            }

        });
    </script>
}