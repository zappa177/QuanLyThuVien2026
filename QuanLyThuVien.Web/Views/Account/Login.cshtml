@* /account/login *@

@model QuanLyThuVien.Web.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/LoginLayout/_LoginLayout.cshtml";
    ViewData["Title"] = "Đăng nhập";
}


<div class="row justify-content-center">
    <!-- Response -->
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

        <h2 class="text-center mb-5 fw-normal">Đăng nhập</h2>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <!-- username -->
            <div class="row mb-4 align-items-center">
                <label asp-for="Username" class="col-sm-4 col-form-label fs-5">Tên đăng nhập</label>
                <div class="col-sm-8">
                    <input asp-for="Username" class="form-control form-control-lg bg-white" autocomplete="off" />
                    <!-- hiển thị thông báo lỗi cho username-->
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
            </div>

            <!-- mật khẩu -->
            <div class="row mb-3 align-items-center">
                <label asp-for="Password" class="col-sm-4 col-form-label fs-5">Mật khẩu</label>
                <div class="col-sm-8">
                    <input asp-for="Password" class="form-control form-control-lg bg-white" />
                    <!-- hiển thị thông báo lỗi cho mật khẩu-->
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <!-- thông báo lỗi nếu username và mật khẩu không đúng -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="row mb-3">
                    <div class="col-sm-8 offset-sm-4 text-center">
                        <span class="text-danger">
                            @ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage
                        </span>
                    </div>
                </div>
            }

            <!-- đăng nhập  -->
            <div class="row mt-4">
                <div class="col-sm-8 offset-sm-4 text-center">
                    <button type="submit" class="btn btn-success btn-lg px-5">
                        Đăng nhập
                    </button>
                </div>
            </div>

        </form>

    </div>
</div>