@model QuanLyThuVien.Web.Models.ChangePasswordViewModel

<div class="container-fluid" style="background-color: #f4f6f9; min-height: 85vh; padding-top: 100px;">

    <!-- Căn giữa khối form -->
    <div class="mx-auto" style="max-width: 450px;">

        <!-- Hiển thị thông báo thành công hoặc lỗi -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center shadow-sm">
                @ViewBag.SuccessMessage
            </div>
        }
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger shadow-sm py-2">
                <div asp-validation-summary="All" class="text-danger mb-0 list-unstyled"></div>
            </div>
        }

        <!-- Bắt đầu form -->
        <form asp-action="ChangePassword" method="post">

            <div class="d-flex align-items-center mb-3">
                <label class="text-dark mb-0" style="width: 140px;">Mật khẩu cũ</label>
                <!-- Form input xám, không viền như bản thiết kế -->
                <input asp-for="OldPassword" type="password" class="form-control rounded-0 border-0 shadow-none" style="background-color: #e0e0e0; flex: 1;" />
            </div>

            <div class="d-flex align-items-center mb-4">
                <label class="text-dark mb-0" style="width: 140px;">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="form-control rounded-0 border-0 shadow-none" style="background-color: #e0e0e0; flex: 1;" />
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn text-white rounded-0 px-4 py-2" style="background-color: #0d6efd; width: 150px;">
                    Đổi mật khẩu
                </button>
            </div>

        </form>
    </div>

</div>