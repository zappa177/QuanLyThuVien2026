@model QuanLyThuVien.Web.Models.PdfReportModel
@{
    Layout = null;

    string title = Model.ReportType == "category" ? "BÁO CÁO THỐNG KÊ THEO THỂ LOẠI" :
                   Model.ReportType == "status" ? "BÁO CÁO TÌNH TRẠNG SÁCH" :
                   "BÁO CÁO 10 SÁCH ĐƯỢC MƯỢN NHIỀU NHẤT";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Xuất PDF</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                padding: 20px;
            }

            h2 {
                text-align: center;
                margin-bottom: 20px;
                text-transform: uppercase;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
            }

            th, td {
                border: 1px solid #000;
                padding: 10px;
                text-align: center;
            }

            th {
                background-color: #f2f2f2;
                font-weight: bold;
            }

            .text-left {
                text-align: left;
                padding-left: 15px;
            }

            .date {
                text-align: right;
                font-style: italic;
                margin-bottom: 30px;
            }
    </style>
</head>
<body>
    <h2>@title</h2>
    <div class="date">Ngày xuất báo cáo: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>

    <table>
        @if (Model.ReportType == "category" && Model.CategoryData != null)
        {
            <thead>
                <tr>
                    <th style="width: 70%;">Tên thể loại</th>
                    <th style="width: 30%;">Số lượng sách</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CategoryData)
                {
                    <tr>
                        <td class="text-left">@item.CategoryName</td>
                        <td>@item.BookCount</td>
                    </tr>
                }
            </tbody>
        }
        else if (Model.ReportType == "status" && Model.StatusData != null)
        {
            <thead>
                <tr>
                    <th style="width: 70%;">Tình trạng</th>
                    <th style="width: 30%;">Số lượng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.StatusData)
                {
                    <tr>
                        <td class="text-left">@item.StatusName</td>
                        <td>@item.BookCount</td>
                    </tr>
                }
            </tbody>
        }
        else if (Model.ReportType == "top10" && Model.TopBookData != null)
        {
            <thead>
                <tr>
                    <th style="width: 70%;">Tên sách</th>
                    <th style="width: 30%;">Lượt mượn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TopBookData)
                {
                    <tr>
                        <td class="text-left">@item.BookTitle</td>
                        <td>@item.BorrowCount</td>
                    </tr>
                }
            </tbody>
        }
    </table>
</body>
</html>