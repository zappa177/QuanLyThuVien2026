@model QuanLyThuVien.Web.Models.UserProfileViewModel

<div class="container-fluid mt-5" style="max-width: 600px;">
    <h3 class="mb-4 text-center">Quản lý thông tin cá nhân</h3>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success text-center">@ViewBag.SuccessMessage</div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Edit" method="post">
        <div class="mb-3 row align-items-center">
            <label class="col-sm-3 col-form-label text-end fw-bold">Tên :</label>
            <div class="col-sm-9">
                <input asp-for="FullName" class="form-control rounded-0 bg-light" required />
            </div>
        </div>

        <div class="mb-3 row align-items-center">
            <label class="col-sm-3 col-form-label text-end fw-bold">Email :</label>
            <div class="col-sm-9">
                <input asp-for="Email" type="email" class="form-control rounded-0 bg-light" />
            </div>
        </div>

        <div class="mb-3 row align-items-center">
            <label class="col-sm-3 col-form-label text-end fw-bold">Số điện thoại :</label>
            <div class="col-sm-9">
                <input asp-for="PhoneNumber" class="form-control rounded-0 bg-light" />
            </div>
        </div>

        <!-- Mã người dùng -->
        <div class="mb-3 row align-items-center">
            <label class="col-sm-3 col-form-label text-end fw-bold">Mã người dùng :</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Admin"))
                {
                    <input asp-for="UserCode" class="form-control rounded-0 bg-light" />
                }
                else
                {
                    <!-- Thêm readonly và đổi màu nền (bg-secondary tráng mờ) để biểu thị bị khóa -->
                    <input asp-for="UserCode" class="form-control rounded-0 text-muted" style="background-color: #e9ecef;" readonly title="Vui lòng liên hệ Admin để thay đổi mã này" />
                }
            </div>
        </div>

        <!-- Ô Position dùng chung cho tất cả mọi người (Lớp / Chức vụ) -->
        <div class="mb-3 row align-items-center">
            <label class="col-sm-3 col-form-label text-end fw-bold">Lớp / Chức vụ :</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Admin"))
                {
                    <input asp-for="Position" class="form-control rounded-0 bg-light" />
                }
                else
                {
                    <input asp-for="Position" class="form-control rounded-0 text-muted" style="background-color: #e9ecef;" readonly title="Vui lòng liên hệ Admin để thay đổi thông tin này" />
                }
            </div>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success px-5 rounded-0">Lưu</button>
        </div>
    </form>
</div>